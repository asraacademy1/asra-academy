  actor User? @relation("PaymentAuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@map("payment_audit_logs")
}

// =============================================================================
// Notifications (PHASE 11) — see docs/NOTIFICATIONS.md
// A business event creates one `Notification` per recipient (the in-app record) and, when the
// event is emailed, one `NotificationDelivery` per channel (a durable outbox row). The outbox is
// written in the SAME transaction as the business change where possible, so a committed event
// always has its notification and a rolled-back one never does. Email is sent after commit by the
// dispatcher (immediately) and the sweep worker (retries); see src/modules/notifications.
// =============================================================================

/// Business event family (O-01). CERTIFICATE and ANNOUNCEMENT have no producing workflow yet
/// (no certificate issuance; announcements pending O-04) — no row of those types is created.
enum NotificationType {
  REGISTRATION
  ENROLLMENT
  PAYMENT
  LIVE_CLASS
  ASSIGNMENT
  EXAMINATION
  RESULT
  CERTIFICATE
  ANNOUNCEMENT

  @@map("notification_type")
}

/// Delivery channels beyond the in-app record itself (O-02: email only; WhatsApp out of scope).
enum NotificationChannel {
  EMAIL

  @@map("notification_channel")
}

/// PENDING: waiting to be sent (or retried at `nextAttemptAt`). SENDING: claimed by one process.
/// ACCEPTED: the provider accepted the message — NOT proof that it reached the inbox.
/// FAILED: permanent provider error or retries exhausted. SKIPPED: no longer applicable
/// (e.g. the class was cancelled before its "scheduled" email went out).
enum NotificationDeliveryStatus {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  SKIPPED

  @@map("notification_delivery_status")
}

/// One in-app notification for one user. Rows are only ever read by their recipient.
model Notification {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  /// Fine-grained event, e.g. "live_class.scheduled" (CHECK format).
  event        String           @db.VarChar(60)
  title        String           @db.VarChar(200)
  /// Plain text (rendered as text, never HTML).
  message      String           @db.VarChar(1000)
  /// App-relative path ("/student/classes"), CHECK starts with "/" — never an external URL.
  actionUrl    String?          @map("action_url") @db.VarChar(500)
  resourceType String?          @map("resource_type") @db.VarChar(40)
  resourceId   String?          @map("resource_id") @db.Uuid
  /// Non-sensitive details for the email template (course title, amount, schedule …).
  data         Json?
  /// Idempotency key per recipient: re-processing the same event never creates a second row.
  dedupeKey    String           @map("dedupe_key") @db.VarChar(200)
  readAt       DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Outbox row for one notification on one channel. Bounded retries with backoff; the provider's
/// message id is recorded when it accepts the message.
model NotificationDelivery {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String                     @map("notification_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  /// CHECK >= 0; at most NOTIFICATION_EMAIL_MAX_ATTEMPTS.
  attempts          Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt         DateTime?                  @map("claimed_at") @db.Timestamptz(3)
  /// Provider message id (Resend email id) once accepted.
  providerMessageId String?                    @map("provider_message_id") @db.VarChar(100)
  acceptedAt        DateTime?                  @map("accepted_at") @db.Timestamptz(3)
  /// Error class/code of the last failure only — never addresses, bodies or keys.
  lastError         String?                    @map("last_error") @db.VarChar(300)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

// =============================================================================
// Administration (PHASE 12) — see docs/ADMIN-DASHBOARD.md §7
// =============================================================================

/// Append-only record of sensitive administrative actions that are not already covered by the
/// payment and assessment audit logs: account status and role changes, course publication and
/// faculty assignment, live-class scheduling/cancellation and manual enrolments. Written in the
/// SAME transaction as the change it describes. No FK on the subject so history survives
/// deletions; no secrets, passwords or tokens are ever stored in `data`.
model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// e.g. "user.status_changed", "user.role_granted", "course.published".
  action     String   @db.VarChar(60)
  /// The signed-in user who acted (SET NULL if that account is ever deleted).
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Uuid
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}

