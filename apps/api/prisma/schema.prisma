  defaultTemplate CertificateTemplate? @relation("DefaultCertificateTemplate", fields: [defaultTemplateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy       User?                @relation("CertificateSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([defaultTemplateId])
  @@index([updatedById])
  @@map("certificate_settings")
}

/// A durable, verifiable credential issued across courses, quizzes, competitions, exams, events, workshops, or manual generation.
/// Preserves immutable template and signature snapshots so historical certificates never drift.
model Certificate {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique public credential code, e.g. "ASRA-2026-XXXX-XXXX" (CHECK `certificates_certificate_number_format`).
  certificateNumber    String                @unique @map("certificate_number") @db.VarChar(50)
  enrollmentId         String?               @unique @map("enrollment_id") @db.Uuid
  userId               String?               @map("user_id") @db.Uuid
  courseId             String?               @map("course_id") @db.Uuid
  academyQuizId        String?               @map("academy_quiz_id") @db.Uuid
  examinationId        String?               @map("examination_id") @db.Uuid
  sourceType           CertificateSourceType @default(COURSE) @map("source_type")
  sourceReferenceId    String?               @map("source_reference_id") @db.VarChar(120)
  sourceLabel          String?               @map("source_label") @db.VarChar(120)
  idempotencyKey       String?               @unique @map("idempotency_key") @db.VarChar(180)
  templateId           String?               @map("template_id") @db.Uuid
  /// Recipient's full name at the time of issue (frozen snapshot for audit and printing).
  recipientName        String                @map("recipient_name") @db.VarChar(150)
  recipientEmail       String?               @map("recipient_email") @db.VarChar(320)
  recipientStudentCode String?               @map("recipient_student_code") @db.VarChar(50)
  certificateTitle     String                @default("Certificate of Completion") @map("certificate_title") @db.VarChar(160)
  /// Subject / course / achievement title at the time of issue (frozen snapshot).
  courseTitle          String                @map("course_title") @db.VarChar(200)
  description          String?               @db.Text
  achievementDetails   String?               @map("achievement_details") @db.VarChar(500)
  /// Historical completion / achievement date recorded on the credential.
  completedAt          DateTime              @default(now()) @map("completed_at") @db.Timestamptz(3)
  /// Timestamp when the certificate was issued.
  issuedAt             DateTime              @default(now()) @map("issued_at") @db.Timestamptz(3)
  status               CertificateStatus     @default(ISSUED)
  revokedAt            DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedReason        String?               @map("revoked_reason") @db.VarChar(500)
  revokedById          String?               @map("revoked_by_id") @db.Uuid
  metadata             Json?
  templateSnapshot     Json?                 @map("template_snapshot")
  signatureSnapshots   Json?                 @map("signature_snapshots")
  reissuedFromId       String?               @map("reissued_from_id") @db.Uuid
  /// Administrator who issued or re-issued this certificate (null if issued automatically by platform).
  issuedById           String?               @map("issued_by_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollment   Enrollment?              @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user         User?                    @relation("CertificateStudent", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  course       Course?                  @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academyQuiz  AcademyQuiz?             @relation(fields: [academyQuizId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  examination  Examination?             @relation(fields: [examinationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  template     CertificateTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  issuedBy     User?                    @relation("CertificateIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  revokedBy    User?                    @relation("CertificateRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reissuedFrom Certificate?             @relation("CertificateReissue", fields: [reissuedFromId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reissues     Certificate[]            @relation("CertificateReissue")
  verification CertificateVerification?
  auditLogs    CertificateAuditLog[]

  @@index([userId, status, issuedAt])
  @@index([courseId, status])
  @@index([academyQuizId, status])
  @@index([examinationId, status])
  @@index([sourceType, status, issuedAt])
  @@index([templateId])
  @@index([status, issuedAt])
  @@index([issuedById])
  @@index([revokedById])
  @@index([reissuedFromId])
  @@map("certificates")
}

/// Public verification record & telemetry ledger for an issued certificate (1:1).
model CertificateVerification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificateId    String    @unique @map("certificate_id") @db.Uuid
  verificationCode String    @unique @map("verification_code") @db.VarChar(50)
  qrPayloadUrl     String    @map("qr_payload_url") @db.VarChar(500)
  verifiedCount    Int       @default(0) @map("verified_count")
  lastVerifiedAt   DateTime? @map("last_verified_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("certificate_verifications")
}

/// Append-only audit log for certificate templates, signatures, issuance, reissue, revocation, and settings.
model CertificateAuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action        String   @db.VarChar(80)
  actorId       String?  @map("actor_id") @db.Uuid
  entityType    String   @map("entity_type") @db.VarChar(40)
  entityId      String   @map("entity_id") @db.VarChar(64)
  certificateId String?  @map("certificate_id") @db.Uuid
  data          Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor       User?        @relation("CertificateAuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  certificate Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([certificateId, createdAt])
  @@index([actorId])
  @@map("certificate_audit_logs")
}

