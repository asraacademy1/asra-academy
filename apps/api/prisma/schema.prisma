  resumeFileSize     Int                  @map("resume_file_size")
  status             JobApplicationStatus @default(RECEIVED)
  consentGiven       Boolean              @default(true) @map("consent_given")
  consentGivenAt     DateTime             @default(now()) @map("consent_given_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  job            Job                           @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  answers        JobApplicationAnswer[]
  statusHistory  JobApplicationStatusHistory[]
  notes          JobApplicationNote[]
  interviews     JobInterview[]
  communications JobApplicationCommunication[]

  @@unique([jobId, normalizedEmail], name: "job_application_job_normalized_email")
  @@index([jobId, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([normalizedEmail])
  @@map("job_applications")
}

model JobApplicationAnswer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  questionId    String?  @map("question_id") @db.Uuid
  questionLabel String   @map("question_label") @db.VarChar(200)
  fieldType     String   @map("field_type") @db.VarChar(50)
  answerText    String?  @map("answer_text") @db.Text
  answerJson    Json?    @map("answer_json")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application JobApplication          @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question    JobApplicationQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([applicationId])
  @@index([questionId])
  @@map("job_application_answers")
}

model JobApplicationStatusHistory {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String                @map("application_id") @db.Uuid
  fromStatus    JobApplicationStatus? @map("from_status")
  toStatus      JobApplicationStatus  @map("to_status")
  reason        String?               @db.VarChar(500)
  changedById   String?               @map("changed_by_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changedBy   User?          @relation("JobApplicationStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([applicationId, createdAt])
  @@map("job_application_status_history")
}

model JobApplicationNote {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  adminId       String   @map("admin_id") @db.Uuid
  note          String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  admin       User           @relation("JobApplicationNoteAdmin", fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([applicationId, createdAt])
  @@map("job_application_notes")
}

model JobInterview {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId      String          @map("application_id") @db.Uuid
  scheduledAt        DateTime        @map("scheduled_at") @db.Timestamptz(3)
  durationMinutes    Int             @default(45) @map("duration_minutes")
  timezone           String          @default("Asia/Kolkata") @db.VarChar(50)
  interviewType      String          @default("Technical Interview") @map("interview_type") @db.VarChar(50)
  meetingUrl         String          @map("meeting_url") @db.VarChar(2048)
  instructions       String?         @db.Text
  notes              String?         @db.Text
  status             InterviewStatus @default(SCHEDULED)
  cancelledAt        DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?         @map("cancellation_reason") @db.VarChar(500)
  createdById        String?         @map("created_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy   User?          @relation("JobInterviewCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([applicationId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("job_interviews")
}

model JobApplicationCommunication {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId     String                 @map("application_id") @db.Uuid
  recipientEmail    String                 @map("recipient_email") @db.VarChar(320)
  template          String                 @db.VarChar(50)
  subject           String                 @db.VarChar(200)
  messageText       String                 @map("message_text") @db.Text
  messageHtml       String?                @map("message_html") @db.Text
  providerMessageId String?                @map("provider_message_id") @db.VarChar(100)
  status            RecruitmentEmailStatus @default(SENT)
  error             String?                @db.VarChar(500)
  sentById          String?                @map("sent_by_id") @db.Uuid
  sentAt            DateTime               @default(now()) @map("sent_at") @db.Timestamptz(3)

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sentBy      User?          @relation("JobApplicationCommunicationSentBy", fields: [sentById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([applicationId, sentAt])
  @@map("job_application_communications")
}
