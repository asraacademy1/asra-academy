  updatedBy         User?                          @relation("TemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  signatures        CertificateTemplateSignature[]
  certificates      Certificate[]
  defaultInSettings CertificateSettings[]          @relation("DefaultCertificateTemplate")

  @@index([isActive, isDefault])
  @@index([createdById])
  @@index([updatedById])
  @@map("certificate_templates")
}

/// Admin-managed digital signature bound to a real signatory person and free-text official title.
model CertificateSignature {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName        String   @map("full_name") @db.VarChar(150)
  designation     String   @db.VarChar(150)
  department      String?  @db.VarChar(150)
  storageProvider String   @map("storage_provider") @db.VarChar(30)
  storageKey      String   @map("storage_key") @db.VarChar(255)
  imageUrl        String?  @map("image_url") @db.VarChar(2048)
  mimeType        String   @default("image/png") @map("mime_type") @db.VarChar(50)
  width           Int
  height          Int
  bytes           Int
  hasTransparency Boolean  @default(true) @map("has_transparency")
  isActive        Boolean  @default(true) @map("is_active")
  createdById     String?  @map("created_by_id") @db.Uuid
  updatedById     String?  @map("updated_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User?                          @relation("SignatureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedBy User?                          @relation("SignatureUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  templates CertificateTemplateSignature[]

  @@index([isActive, createdAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("certificate_signatures")
}

/// Ordered signature placement configuration on a certificate template (2 to 4 unique active signatures).
model CertificateTemplateSignature {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId      String   @map("template_id") @db.Uuid
  signatureId     String   @map("signature_id") @db.Uuid
  sortOrder       Int      @map("sort_order")
  positionLabel   String   @map("position_label") @db.VarChar(40)
  showName        Boolean  @default(true) @map("show_name")
  showDesignation Boolean  @default(true) @map("show_designation")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  template  CertificateTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  signature CertificateSignature @relation(fields: [signatureId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([templateId, signatureId])
  @@unique([templateId, sortOrder])
  @@index([signatureId])
  @@map("certificate_template_signatures")
}

/// Singleton platform certificate branding, verification notice, and auto-issuance settings.
model CertificateSettings {
  id                          String   @id @default("default") @db.VarChar(32)
  academyName                 String   @default("ASRA Academy") @map("academy_name") @db.VarChar(160)
  academyTagline              String   @default("Academy of Islamic & Contemporary Studies") @map("academy_tagline") @db.VarChar(220)
  defaultTemplateId           String?  @map("default_template_id") @db.Uuid
  verificationNotice          String   @default("Tamper-resistant credential registered in ASRA Academy central database.") @map("verification_notice") @db.VarChar(500)
  showQrOnCertificates        Boolean  @default(true) @map("show_qr_on_certificates")
  autoIssueOnCourseCompletion Boolean  @default(true) @map("auto_issue_on_course_completion")
  autoIssueOnQuizCompletion   Boolean  @default(false) @map("auto_issue_on_quiz_completion")
