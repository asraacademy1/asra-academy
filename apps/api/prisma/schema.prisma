/// Reusable, database-backed certificate layout template (Classic, Modern, Premium).
model CertificateTemplate {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String                   @unique @db.VarChar(60)
  name             String                   @db.VarChar(120)
  style            CertificateTemplateStyle
  description      String?                  @db.VarChar(500)
  defaultTitle     String                   @map("default_title") @db.VarChar(160)
  defaultSubtitle  String?                  @map("default_subtitle") @db.VarChar(200)
  defaultBodyText  String                   @map("default_body_text") @db.VarChar(1000)
  issuingAuthority String                   @default("ASRA Academy") @map("issuing_authority") @db.VarChar(160)
  config           Json                     @default("{}")
  version          Int                      @default(1)
  isActive         Boolean                  @default(true) @map("is_active")
  isDefault        Boolean                  @default(false) @map("is_default")
  createdById      String?                  @map("created_by_id") @db.Uuid
  updatedById      String?                  @map("updated_by_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

